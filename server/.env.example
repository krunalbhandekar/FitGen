# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas: Database > Connect > Drivers. Remember to URL-encode any
# special characters in the password, and add the DB name before the "?".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fitgen?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Web application). This must be the SAME client id the frontend uses.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
# The single browser origin allowed to call this API.
# A leading "*." wildcard covers every Vercel preview deployment,
# e.g. CLIENT_ORIGIN=https://*.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ─── RBAC ─────────────────────────────────────────────────────────────────────
# No variable here. Roles are managed entirely from the admin UI.
#
# On a brand-new database there is no administrator yet, so the first one must
# be set directly in MongoDB (once):
#
#   db.users.updateOne({ email: "you@example.com" }, { $set: { role: "admin" } })
#
# After that, use Admin → User roles to grant or revoke access.

# ─── AI generation (Phase 3) — optional; falls back to the rule-based engine ──
GROQ_API_KEY=

# Groq model. Defaults to openai/gpt-oss-120b. The report names Llama 3.1/3.3,
# but Groq has retired those — see src/services/groqClient.js.
GROQ_MODEL=openai/gpt-oss-120b
